# SQLite（相对路径以启动目录为准，父目录自动创建）
DATABASE_URL=sqlite:///./data/mcp.db


# 授权Tokens列表 - 用于API访问控制
# 格式: AUTH_TOKENS=["token1","token2","token3"]
# 示例: AUTH_TOKENS=["abc123xyz","def456uvw"]
AUTH_TOKENs=["ab10839e-ca8d-11f0-8a1c-1866da5b1179","bb700b42-ca8d-11f0-b6d3-1866da5b1179"]

# 代理配置
PROXY_URL=http://192.168.254.146:4480
PROXY_RULES=*.google.com,api.twitter.com,https://somewhere.com/v1/*,http://192.168.254.195:17771/*


# 应用配置
APP_NAME=Dynamic MCP Server
DEBUG=true
enable_console=False
